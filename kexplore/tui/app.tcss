#path {
    background: $panel;
    color: $text;
    padding: 0 1;
    height: 1;
}

Horizontal {
    height: 1fr;
}

#sidebar {
    width: 44;
    border-right: solid $panel;
}

#nav {
    height: 1fr;
}

#views {
    height: 3;
}

#detail {
    width: 1fr;
    /* The tutorial narration floats over the table rather than sitting in it:
       the field column is clipped to MAX_CELL, and prose wrapped to that width
       cannot be read. Its own layer lets it take the width of the pane. */
    layers: base callout;
}

#doc {
    height: auto;
    max-height: 2;
    color: $text-muted;
    padding: 0 1;
}

/* Only visible while something is fetching, so it is deliberately loud. */
#activity {
    height: 1;
    background: $warning-muted;
    color: $text;
    padding: 0 1;
}

#tutorial-banner, #tour-banner {
    display: none;
    height: auto;
    background: $panel;
    border-bottom: solid $accent;
    padding: 1 2;
    margin-bottom: 1;
}

#tutorial-landing, #tour-landing {
    display: none;
    height: 1fr;
    background: $surface;
    padding: 1 2 2 2;
    overflow-y: scroll;
    scrollbar-gutter: stable;
}

#tutorial-landing:focus, #tour-landing:focus {
    background-tint: $foreground 5%;
}

#tutorial-landing-content {
    height: auto;
    width: 1fr;
    padding-bottom: 2;
}


#fields {
    height: 1fr;
}

#hint {
    height: auto;
    max-height: 3;
    background: $panel;
    color: $text;
    padding: 0 1;
}

#search {
    dock: bottom;
    height: 3;
}

/* ---------------------------------------------------------- focus mode */

#graph-path {
    background: $panel;
    color: $text;
    padding: 0 1;
    height: 1;
}

/* The canvas is wider and taller than the terminal by design -- the graph is
   panned, not shrunk to fit, because shrinking it would mean dropping the
   traversal labels that are the point of the view. */
#graph-scroll {
    height: 1fr;
    overflow: auto auto;
}

#graph-canvas {
    width: auto;
    height: auto;
    padding: 1 2;
}

#graph-info {
    height: auto;
    max-height: 3;
    background: $panel;
    color: $text;
    padding: 0 1;
}


/* Step narration, positioned under the row it explains. Width and offset are
   set from Python, because both depend on where the cursor landed.

   The border and the fill are what separate it from the table: without them it
   reads as three more rows, and the rows it covers show through at its edges.
   It sits on its own layer, so the rows underneath keep their positions and
   the row being aimed at never moves while it is being read. */
#tutorial-callout {
    layer: callout;
    display: none;
    width: auto;
    height: auto;
    max-width: 100%;
    background: $panel;
    color: $text;
    border: round $accent;
    padding: 0 2;
}
